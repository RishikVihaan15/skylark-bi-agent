# Copy this file to .env and fill in real values. Never commit the real .env.
GEMINI_API_KEY=your_gemini_api_key_here        # free key from https://aistudio.google.com/apikey
MONDAY_API_KEY=your_monday_api_key_here        # from monday.com Profile > Developers > API tokens
MONDAY_WORK_ORDERS_BOARD_ID=your_work_orders_board_id
MONDAY_DEALS_BOARD_ID=your_deals_board_id
